# Graph Series (web interface): the only setting the code reads.
#
# NEXT_PUBLIC_API_URL is the base URL of the backend API as the *browser* sees it.
# Next.js inlines it into the bundle at build time, so changing it needs a rebuild.
#
#   - Production: leave the default. A reverse proxy on the same origin forwards
#     /api/backend/* to the API server (see docs/deployment.md).
#   - Local development against a backend on your machine:
#       NEXT_PUBLIC_API_URL=http://localhost:8000
#     and put the line into nextjs/.env.local (or export it before `npm run dev`).
#
# The docker-compose.yml build argument of the same name is set to /api/backend.
NEXT_PUBLIC_API_URL=/api/backend

# docker-compose.yml (read automatically from a .env file next to it):
# PRIVATE_BIND_IP is the address of this host on the private network (for example the output of
# `tailscale ip -4`). Qdrant (6333, 6334) and the embedding service (8004) are published on it only.
# The compose file refuses to start while it is unset.
PRIVATE_BIND_IP=
